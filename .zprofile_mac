###############################################################################
#                        ~/.zprofile_mac CONFIGURATION                         #
# --------------------------------------------------------------------------- #
# Author        : Martin Bullman                                              #
# Purpose       : macOS-specific login shell environment — PATH, Homebrew,   #
#                 and language runtime configuration.                         #
#                                                                             #
# Last Updated : 2026-06-13                                                   #
###############################################################################

# fnm node version manager.
if command -v fnm &>/dev/null; then
    eval "$(fnm env --use-on-cd)"
fi

# homebrew settings.
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export MANPATH="/opt/homebrew/share/man:${MANPATH}"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"

# JetBrains Toolbox CLI scripts.
if [ -d "$HOME/Library/Application Support/JetBrains/Toolbox/scripts" ]; then
    export PATH="$PATH:$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
fi

# java path settings. openjdk@25 (current LTS) is keg-only, so it is not linked into
# /opt/homebrew/bin. This lives in .zprofile rather than .zshrc because Homebrew's mvn
# wrapper falls back to a hardcoded /opt/homebrew/opt/openjdk path when JAVA_HOME is
# unset — and that path no longer exists — so non-interactive shells need it too.
if [ -d "/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home" ]; then
    export JAVA_HOME="/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home"
    export PATH="$JAVA_HOME/bin:$PATH"
fi

# ruby path settings.
if [ -d "/opt/homebrew/opt/ruby/bin" ]; then
    export PATH=/opt/homebrew/opt/ruby/bin:$PATH
    export PATH="$(ruby -e 'puts Gem.user_dir')/bin:$PATH"
fi

# python path settings.
if command -v python3 &>/dev/null; then
    export PATH="$(python3 -m site --user-base)/bin:${PATH}"
fi
