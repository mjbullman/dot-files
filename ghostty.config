###############################################################################
#                           GHOSTTY CONFIGURATION                             #
# --------------------------------------------------------------------------- #
# Author  : Martin Bullman                                                    #
# Purpose : Custom configuration file for Ghostty terminal emulator           #
# Docs    : https://ghostty.org/docs/config                                   #
###############################################################################

# theme
theme = Catppuccin Mocha

# font meslo
font-size = 15
font-family = MesloLGS NF

# font jetbrains mono
# Only the Regular face of the Nerd Font build is installed; Ghostty
# synthesises bold/italic from it.
#font-size = 15
#font-family = JetBrainsMonoNL Nerd Font Mono

# window
window-padding-x = 0
window-padding-y = 0
# split the sub-cell remainder (window height not an exact multiple of the cell
# height) evenly top/bottom instead of dumping it all below the last row
window-padding-balance = true
keybind = shift+enter=text:\x1b\r
